/* Soft blue light theme */

QWidget { background-color: #eaf4ff; color: #17324d; font-family: "DejaVu Sans"; font-size: 14px; }
QLabel { background: transparent; min-height: 24px; }
QLabel#headerTitle { color: #0b4f8a; font-size: 35px; font-weight: bold; }
QLabel#subTitle { color: #1769aa; font-size: 24px; }
QLabel#error { color: #c62828; font-weight: bold; }
QLabel#serviceName { color: #0c4778; font-size: 16px; font-weight: bold; }
QLabel#serviceLogin, QLabel#miniLabel { color: #51738f; }

QLineEdit, QSpinBox, QComboBox {
    min-height: 28px; padding: 4px 9px;
    color: #17324d; background-color: #fafdff;
    border: 1px solid #9dc4e5; border-radius: 6px;
    selection-background-color: #1687d9; selection-color: #ffffff;
}
QLineEdit:focus, QSpinBox:focus, QComboBox:focus { border: 2px solid #1687d9; }
QLineEdit:disabled, QSpinBox:disabled, QComboBox:disabled { color: #7890a4; background-color: #dceaf5; }

QPushButton {
    min-height: 30px; padding: 3px 14px;
    color: #123c5f; background-color: #f7fbff;
    border: 1px solid #8bb9df; border-radius: 6px;
}
QPushButton:hover { color: #063b66; background-color: #d5ebff; border-color: #2387d1; }
QPushButton:pressed { background-color: #b9dcfa; }
QPushButton:focus { border: 2px solid #1687d9; }
QPushButton:disabled { color: #8195a6; background-color: #dce8f2; }
QPushButton#dangerButton:hover { color: #a61b1b; background-color: #ffe7e7; border-color: #dc6b6b; }
QPushButton#dangerButton:pressed { background-color: #ffcfcf; }

QCheckBox { spacing: 7px; }
QCheckBox::indicator { width: 16px; height: 16px; background: #fafdff; border: 1px solid #78acd5; border-radius: 4px; }
QCheckBox::indicator:hover { border-color: #087bc1; }
QCheckBox::indicator:checked { background-color: #1687d9; border-color: #0871b5; }
QComboBox::drop-down, QSpinBox::up-button, QSpinBox::down-button { border: none; width: 22px; }
QComboBox QAbstractItemView {
    padding: 4px; color: #17324d; background-color: #fafdff;
    border: 1px solid #8bb9df; selection-background-color: #cce8ff; selection-color: #123c5f; outline: none;
}

QGroupBox { margin-top: 10px; padding-top: 10px; border: 1px solid #9dc4e5; border-radius: 8px; font-weight: bold; }
QGroupBox::title { subcontrol-origin: margin; padding: 0 6px; color: #1769aa; }
QScrollArea { background-color: #dceeff; border: 1px solid #a8cce9; border-radius: 8px; }
QScrollBar:vertical { width: 10px; margin: 3px; background: transparent; }
QScrollBar::handle:vertical { min-height: 28px; background-color: #7fb3db; border-radius: 4px; }
QScrollBar::handle:vertical:hover { background-color: #418cc5; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: none; border: none; }

QMessageBox, QMessageBox QLabel, QDialog { background-color: #edf7ff; }
QDialog { border: 1px solid #9dc4e5; border-radius: 10px; }
QListWidget { color: #17324d; background: #fafdff; border: 1px solid #8bb9df; border-radius: 5px; }
QListWidget::item { padding: 4px; }
QListWidget::item:selected { background-color: #c5e4ff; color: #0c4778; }
QServiceCardWidget { background-color: #f8fcff; border: 1px solid #a8cce9; border-radius: 7px; }
QServiceCardWidget:hover { background-color: #d7ecff; border-color: #65a8d9; }

QSlider::groove:horizontal { height: 8px; background: #bdd8ed; border-radius: 4px; }
QSlider::sub-page:horizontal { background: #1687d9; border-radius: 4px; }
QSlider::handle:horizontal { width: 16px; margin: -4px 0; background: #ffffff; border: 2px solid #1687d9; border-radius: 8px; }
QToolTip { color: #ffffff; background-color: #164b73; border: 1px solid #0c3655; padding: 5px 7px; }
